<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lumi - Memory Cards</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  min-height: 100vh;
  background: #111722;
  color: #f5eddf;
  font-family: 'DM Sans', sans-serif;
  padding: 25px 16px;
}

.container {
  max-width: 850px;
  margin: auto;
}

header {
  text-align: center;
  margin: 20px 0 30px;
}

.logo {
  color: #d9bd87;
  letter-spacing: 5px;
  font-size: 12px;
  margin-bottom: 15px;
}

h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(35px, 7vw, 55px);
  color: #f5e8cf;
}

.subtitle {
  color: #aaa9a4;
  margin-top: 10px;
  font-size: 13px;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-bottom: 25px;
}

.stat {
  background: #1d2633;
  border: 1px solid #3a3b3a;
  border-radius: 14px;
  padding: 15px 5px;
  text-align: center;
}

.stat small {
  display: block;
  color: #b6a98e;
  font-size: 10px;
  letter-spacing: 2px;
  margin-bottom: 8px;
}

.stat strong {
  font-size: 21px;
  color: #f3dfb8;
}

.board {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 13px;
}

.card {
  aspect-ratio: 3 / 3.8;
  perspective: 800px;
  cursor: pointer;
  border: none;
  background: transparent;
}

.card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform .5s;
}

.card.flipped .card-inner,
.card.matched .card-inner {
  transform: rotateY(180deg);
}

.card-front,
.card-back {
  position: absolute;
  inset: 0;
  border-radius: 15px;
  backface-visibility: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.card-front {
  background: linear-gradient(145deg, #303d4c, #1c2634);
  border: 1px solid #b59b6e;
  color: #d7bd8c;
  font-family: 'Playfair Display', serif;
  font-size: 30px;
  box-shadow: 0 5px 15px #0004;
}

.card-front span {
  font-size: 10px;
  letter-spacing: 3px;
  margin-top: 8px;
}

.card-back {
  transform: rotateY(180deg);
  background: linear-gradient(145deg, #f5ead7, #dfcbb0);
  color: #26303a;
  border: 2px solid #c8a96e;
  box-shadow: 0 5px 20px #0004;
}

.character {
  font-size: clamp(30px, 8vw, 55px);
}

.card-back p {
  font-family: 'Playfair Display', serif;
  font-size: 12px;
  margin-top: 9px;
  font-weight: bold;
}

.card.matched .card-back {
  background: linear-gradient(145deg, #d6e4d4, #b8ceb8);
  border-color: #a5bda0;
}

.card:disabled {
  cursor: default;
}

.actions {
  text-align: center;
  margin-top: 28px;
}

button.restart {
  border: 1px solid #c6a66f;
  background: #c6a66f;
  color: #18202b;
  padding: 13px 32px;
  border-radius: 30px;
  font-weight: bold;
  cursor: pointer;
  transition: .3s;
}

button.restart:hover {
  background: #f1dfbd;
  transform: translateY(-2px);
}

.message {
  text-align: center;
  margin-top: 20px;
  min-height: 25px;
  color: #d7bd8c;
  font-size: 14px;
}

footer {
  text-align: center;
  color: #777e87;
  font-size: 11px;
  margin-top: 35px;
  letter-spacing: 2px;
}

@media(max-width: 450px) {
  .board {
    gap: 9px;
  }

  .card-front,
  .card-back {
    border-radius: 11px;
  }

  .card-back p {
    font-size: 10px;
  }
}
</style>
</head>

<body>

<div class="container">

<header>
  <div class="logo">✦ L U M I   S T U D I O ✦</div>
  <h1>Memory Cards</h1>
  <p class="subtitle">
    Find your matching friends in this little magical world.
  </p>
</header>

<div class="stats">
  <div class="stat">
    <small>MOVES</small>
    <strong id="moves">0</strong>
  </div>

  <div class="stat">
    <small>TIME</small>
    <strong id="time">00:00</strong>
  </div>

  <div class="stat">
    <small>PAIRS</small>
    <strong id="pairs">0 / 8</strong>
  </div>
</div>

<div class="board" id="board"></div>

<div class="message" id="message">
  ✦ Find all 8 matching pairs! ✦
</div>

<div class="actions">
  <button class="restart" onclick="startGame()">
    ↻ Play Again
  </button>
</div>

<footer>
  MADE WITH LOVE · LUMI MEMORY GAME
</footer>

</div>

<script>

const characters = [
  { emoji: "🐰", name: "Bunny" },
  { emoji: "🐻", name: "Teddy" },
  { emoji: "🐱", name: "Kitty" },
  { emoji: "🦊", name: "Foxy" },
  { emoji: "🐼", name: "Panda" },
  { emoji: "🐸", name: "Froggy" },
  { emoji: "🐧", name: "Pingu" },
  { emoji: "🦄", name: "Unicorn" }
];

let firstCard = null;
let secondCard = null;
let locked = false;
let moves = 0;
let pairs = 0;
let seconds = 0;
let timer = null;
let started = false;

const board = document.getElementById("board");

function startGame() {

  clearInterval(timer);

  firstCard = null;
  secondCard = null;
  locked = false;
  moves = 0;
  pairs = 0;
  seconds = 0;
  started = false;

  document.getElementById("moves").textContent = 0;
  document.getElementById("pairs").textContent = "0 / 8";
  document.getElementById("time").textContent = "00:00";
  document.getElementById("message").textContent =
    "✦ Find all 8 matching pairs! ✦";

  board.innerHTML = "";

  let cards = [...characters, ...characters];

  cards.sort(() => Math.random() - 0.5);

  cards.forEach((character, index) => {

    const card = document.createElement("button");

    card.className = "card";
    card.type = "button";
    card.dataset.name = character.name;
    card.setAttribute("aria-label", "Kartu tertutup");

    card.innerHTML = `
      <div class="card-inner">

        <div class="card-front">
          ✦
          <span>LUMI</span>
        </div>

        <div class="card-back">
          <div class="character">${character.emoji}</div>
          <p>${character.name}</p>
        </div>

      </div>
    `;

    card.addEventListener("click", () => flipCard(card));

    board.appendChild(card);

  });
}

function startTimer() {

  if (started) return;

  started = true;

  timer = setInterval(() => {

    seconds++;

    let min = Math.floor(seconds / 60);
    let sec = seconds % 60;

    document.getElementById("time").textContent =
      String(min).padStart(2, "0") + ":" +
      String(sec).padStart(2, "0");

  }, 1000);
}

function flipCard(card) {

  if (
    locked ||
    card === firstCard ||
    card.classList.contains("flipped") ||
    card.classList.contains("matched")
  ) return;

  startTimer();

  card.classList.add("flipped");

  if (!firstCard) {

    firstCard = card;
    return;

  }

  secondCard = card;
  moves++;

  document.getElementById("moves").textContent = moves;

  checkMatch();
}

function checkMatch() {

  let isMatch =
    firstCard.dataset.name === secondCard.dataset.name;

  if (isMatch) {

    firstCard.classList.add("matched");
    secondCard.classList.add("matched");

    firstCard.disabled = true;
    secondCard.disabled = true;

    pairs++;

    document.getElementById("pairs").textContent =
      pairs + " / 8";

    resetTurn();

    if (pairs === 8) {
      clearInterval(timer);

      document.getElementById("message").textContent =
        "🎉 Congratulations! You found all the characters!";

    }

  } else {

    locked = true;

    setTimeout(() => {

      firstCard.classList.remove("flipped");
      secondCard.classList.remove("flipped");

      resetTurn();

    }, 900);

  }
}

function resetTurn() {

  firstCard = null;
  secondCard = null;
  locked = false;

}

/* SKOR DAN PROGRESS */

function updateStats() {
  document.getElementById("moves").textContent = moves;
  document.getElementById("timer").textContent = formatTime(seconds);
  document.getElementById("score").textContent = score;
  document.getElementById("progressText").textContent =
    matchedPairs + " / " + totalPairs + " pasangan";

  document.getElementById("progressFill").style.width =
    (matchedPairs / totalPairs * 100) + "%";
}

/* MEMBUKA KARAKTER */

function unlockCharacter(id) {
  if (!unlocked.includes(id)) {
    unlocked.push(id);
    saveStorage("lumiUnlocked", unlocked);
    renderCollection();
  }
}

/* KOLEKSI KARAKTER */

function renderCollection() {
  const grid = document.getElementById("collectionGrid");

  grid.innerHTML = characters.map(character => {
    const isUnlocked = unlocked.includes(character.id);

    return `
      <div class="character ${isUnlocked ? "" : "locked"}">
        <div class="character-emoji">
          ${isUnlocked ? character.emoji : "🔒"}
        </div>
        <strong>${isUnlocked ? character.name : "???"}</strong>
        <small>${isUnlocked ? "Berhasil dikumpulkan" : "Belum ditemukan"}</small>
        <div class="rank">${character.rank}</div>
      </div>
    `;
  }).join("");
}

/* MENYELESAIKAN GAME */

function finishGame() {
  clearInterval(timerInterval);

  const bonus = Math.max(0, 300 - seconds * 2);
  const finalScore = score + bonus;

  score = finalScore;
  updateStats();

  const oldBest = bestScores[selectedLevel] || 0;
  let newRecord = false;

  if (finalScore > oldBest) {
    bestScores[selectedLevel] = finalScore;
    saveStorage("lumiBestScores", bestScores);
    newRecord = true;
  }

  document.getElementById("winMessage").textContent =
    "Hebat, " + playerName + "! Kamu berhasil menemukan semua " +
    totalPairs + " pasangan kartu.";

  document.getElementById("winReward").textContent =
    "Skor akhir: " + finalScore +
    (newRecord ? " · 🏆 Rekor baru!" : " · Bonus waktu: " + bonus);

  document.getElementById("winModal").classList.add("show");

  playSound(900);
}

function closeWin() {
  document.getElementById("winModal").classList.remove("show");
}

/* MENGULANGI GAME */

function restartGame() {
  startGame();
}

/* SUARA GAME */

let audioContext = null;

function playSound(frequency = 500) {
  if (!soundEnabled) return;

  try {
    audioContext = audioContext || new (
      window.AudioContext || window.webkitAudioContext
    )();

    if (audioContext.state === "suspended") {
      audioContext.resume();
    }

    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();

    oscillator.type = "sine";
    oscillator.frequency.value = frequency;

    gain.gain.setValueAtTime(0.08, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(
      0.001,
      audioContext.currentTime + 0.2
    );

    oscillator.connect(gain);
    gain.connect(audioContext.destination);

    oscillator.start();
    oscillator.stop(audioContext.currentTime + 0.2);
  } catch (error) {
    console.log("Suara tidak tersedia.");
  }
}

function toggleSound() {
  soundEnabled = !soundEnabled;
  saveStorage("lumiSound", soundEnabled);
  updateSoundButton();
}

function updateSoundButton() {
  document.getElementById("soundButton").textContent =
    soundEnabled ? "🔊 Suara" : "🔇 Suara";
}

/* INISIALISASI */

function initializeGame() {
  document.getElementById("playerInput").value = playerName;

  renderAvatars();
  renderCollection();
  updateSoundButton();

  if (playerName) {
    updatePlayer();
  }

  selectLevel("easy");
}

initializeGame();


startGame();

</script>

</body>
